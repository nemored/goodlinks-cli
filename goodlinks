#!/usr/bin/env zsh

set -euo pipefail

BASE_URL_DEFAULT="http://localhost:9428/api/v1"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/goodlinks-cli"
TOKEN_FILE="$CONFIG_DIR/token"

BASE_URL="${GOODLINKS_BASE_URL:-$BASE_URL_DEFAULT}"
TOKEN="${GOODLINKS_TOKEN:-}"
RAW_OUTPUT=0
JSON_OUTPUT=0
NUL_OUTPUT=0
OUTPUT_COLUMNS=""

die() {
  print -u2 "goodlinks: $*"
  exit 1
}

need() {
  command -v "$1" >/dev/null 2>&1 || die "missing required command: $1"
}

usage() {
  cat <<'EOF'
GoodLinks CLI

Usage:
  goodlinks [global options] <command> [options]

Global options:
  --token <token>       API token. Defaults to GOODLINKS_TOKEN or config token.
  --base-url <url>      API base URL. Defaults to GOODLINKS_BASE_URL or http://localhost:9428/api/v1.
  --json               Pretty-print JSON responses.
  --raw                Print response body exactly as returned.
  -O <columns>         Select comma-separated tabular output columns, using lowercase names.
  -0                   Separate tabular records with NUL instead of newline.
  -h, --help           Show help.

Default tabular fields:
  links:       STARRED TITLE URL TAGS READAT
  lists:       ID
  tags:        TAG
  highlights:  CONTENT CREATEDAT

Token commands:
  config set-token <token>
  config show

Link commands:
  links list [filters]
  links get --id <id>
  links get-url --url <url>
  links current
  links add --url <url> [--title <text>] [--summary <text>] [--tag <tag> ...] [--read <bool>] [--starred <bool>] [--added-at <timestamp>]
  links update --id <id> [--title <text>] [--summary <text>] [--starred <bool>] [--read <bool>] [--add-tag <tag> ...] [--remove-tag <tag> ...] [--tag <tag> ...] [--clear-tags]
  links delete --id <id> [--id <id> ...]
  links content --id <id> [--format html|plaintext|markdown] [--auto-download <bool>]

List commands:
  lists list
  lists get --list all|unread|read|starred|untagged|highlighted [--search <text>] [--tag <tag> ...] [--include-read <bool>] [--limit <n>] [--offset <n>]

Tag commands:
  tags list

Highlight commands:
  highlights list [filters]
  highlights update --id <id> [--note <text>]
  highlights export --link-id <id>

Common link filters:
  --search <text> --tag <tag> --starred <bool> --read <bool> --tagged <bool>
  --highlighted <bool> --word-count-min <n> --word-count-max <n>
  --added-after <timestamp> --added-before <timestamp>
  --read-after <timestamp> --read-before <timestamp>
  --sort <value> --limit <n> --offset <n>

Highlight filters:
  --q <text> --link-id <id> --content <text> --note <text>
  --created-after <timestamp> --created-before <timestamp>
  --sort <value> --limit <n> --offset <n>

Examples:
  goodlinks links list --read false --search python --limit 20
  goodlinks -O id,title,url links list --read false
  goodlinks -0 -O id links list --read false | cut -z -f1 | xargs -0 -n1 echo
  goodlinks --json links get --id abc123
  goodlinks links add --url https://example.com --tag reading --starred true
  goodlinks --raw links content --id abc123 --format markdown
  goodlinks highlights update --id highlight123 --note "Key insight"
EOF
}

read_token() {
  if [[ -n "$TOKEN" ]]; then
    return
  fi

  if [[ -f "$TOKEN_FILE" ]]; then
    TOKEN="$(<"$TOKEN_FILE")"
    TOKEN="${TOKEN//$'\n'/}"
  fi
}

urlencode() {
  jq -nr --arg v "$1" '$v|@uri'
}

json_string_array() {
  jq -cn '$ARGS.positional' --args "$@"
}

append_query() {
  local query_name="$1"
  local key="$2"
  local value="$3"

  [[ -n "$value" ]] || return
  local encoded
  encoded="$(urlencode "$key")=$(urlencode "$value")"
  eval "$query_name+=(\"\$encoded\")"
}

make_url() {
  local endpoint_path="$1"
  shift
  local query=("$@")
  local url="${BASE_URL}${endpoint_path}"

  if (( ${#query[@]} > 0 )); then
    local IFS='&'
    url="${url}?${query[*]}"
  fi

  print -r -- "$url"
}

format_json_response() {
  local content_type="$1"
  local formatter="$2"

  if (( RAW_OUTPUT )); then
    cat
    return
  fi

  if [[ "$content_type" == application/json* ]]; then
    if (( JSON_OUTPUT )); then
      jq .
    elif [[ -t 1 && "$formatter" != "raw" ]] && (( ! NUL_OUTPUT )); then
      terminal_json "$formatter"
    else
      tabular_json "$formatter"
    fi
  else
    cat
  fi
}

terminal_width() {
  if [[ -n "${COLUMNS:-}" && "$COLUMNS" -gt 0 ]]; then
    print -r -- "$COLUMNS"
  else
    tput cols 2>/dev/null || print 80
  fi
}

terminal_json() {
  local formatter="$1"
  local width
  width="$(terminal_width)"

  jq -rj --arg formatter "$formatter" --arg columns "$OUTPUT_COLUMNS" --argjson terminalWidth "$width" '
    def clean:
      if . == null then ""
      elif type == "array" then map(tostring) | join(",")
      else tostring
      end
      | gsub("[\t\r\n]"; " ");

    def requested_columns($default):
      if $columns == "" then
        $default
      else
        $columns
        | gsub("[[:space:]]+"; "")
        | split(",")
        | map(ascii_upcase)
        | map(select(. != ""))
      end;

    def link_map:
      {
        ID: ["id"],
        URL: ["url"],
        TITLE: ["title"],
        SUMMARY: ["summary"],
        AUTHOR: ["author"],
        TAGS: ["tags"],
        WORDCOUNT: ["wordCount"],
        STARRED: ["starred"],
        HIGHLIGHTED: ["highlighted"],
        ADDEDAT: ["addedAt"],
        MODIFIEDAT: ["modifiedAt"],
        READAT: ["readAt"]
      };

    def highlight_map:
      {
        ID: ["id"],
        LINKID: ["linkID"],
        CONTENT: ["content"],
        MARKDOWNCONTENT: ["markdownContent"],
        NOTE: ["note"],
        CREATEDAT: ["createdAt"]
      };

    def list_map:
      {ID: ["id"], NAME: ["name"]};

    def generic_map:
      {ID: ["id"], URL: ["url"], TITLE: ["title"], NAME: ["name"], LINKID: ["linkID"], CONTENT: ["content"], NOTE: ["note"]};

    def data_rows:
      if $formatter == "links" or $formatter == "highlights" then
        if type == "object" and has("data") then .data else [.] end
      elif $formatter == "lists" or $formatter == "tags" then
        if type == "array" then . else [.] end
      else
        if type == "array" then . elif type == "object" and has("data") then .data else [.] end
      end;

    def columns:
      if $formatter == "links" then requested_columns(["STARRED", "TITLE", "URL", "TAGS", "READAT"])
      elif $formatter == "highlights" then requested_columns(["CONTENT", "CREATEDAT"])
      elif $formatter == "lists" then requested_columns(["ID"])
      elif $formatter == "tags" then requested_columns(["TAG"])
      else requested_columns(["ID", "URL", "TITLE", "NAME", "LINKID", "CONTENT", "NOTE"])
      end;

    def validate_col($col; $map):
      if $formatter == "tags" then
        if $col == "TAG" then true else error("unknown output column for tags: " + $col) end
      elif $map | has($col) then
        true
      else
        error("unknown output column for " + $formatter + ": " + $col)
      end;

    def ellipsis($s; $width):
      ($s | tostring) as $text
      | ($width | floor) as $w
      | if $w <= 0 then ""
        elif ($text | length) <= $w then $text
        elif $w == 1 then "…"
        else ($text[0:($w - 1)] + "…")
        end;

    def strip_url:
      clean
      | sub("^[Hh][Tt][Tt][Pp][Ss]?://"; "")
      | gsub("^([Ww][Ww][Ww][0-9]*\\.)+"; "");

    def truncate_url($width):
      strip_url as $url
      | ($url | split("/")[0]) as $domain
      | ($url | sub("^[^/]*"; "")) as $path
      | if ($url | length) <= $width then $url
        else
          ([($domain | length), 30, $width] | min) as $domainWidth
          | ellipsis($domain; $domainWidth) as $shownDomain
          | if ($shownDomain | length) >= $width then
              ellipsis($shownDomain; $width)
            elif $path == "" then
              $shownDomain
            else
              $shownDomain + ellipsis($path; ($width - ($shownDomain | length)))
            end
        end;

    def format_timestamp($width):
      clean as $value
      | ($width | floor) as $w
      | if $value == "" then ""
        else
          ($value[0:10]) as $date
          | ($value[11:16]) as $time
          | ($date[2:4] + $date[5:7] + $date[8:10]) as $compactDate
          | if $w >= 20 and ($value | length) >= 20 then $value[0:20]
            elif $w >= 16 and ($date | length) == 10 and ($time | length) == 5 then "\($date) \($time)"
            elif $w >= 10 and ($date | length) == 10 then $date
            elif $w >= 8 and ($date | length) == 10 then "\($date[2:4])-\($date[5:7])-\($date[8:10])"
            elif $w >= 6 and ($date | length) == 10 then $compactDate
            else ellipsis((if ($date | length) == 10 then $compactDate else $value end); $w)
            end
        end;

    def tag_counts($rows):
      reduce ($rows[] | (.tags // [])[]?) as $tag ({};
        .[$tag] = ((.[$tag] // 0) + 1)
      );

    def format_tags($counts; $width):
      (.tags // []) as $rawTags
      | ($rawTags | unique | map({tag: ., count: ($counts[.] // 0)}) | sort_by(-.count, .tag) | map(.tag)) as $tags
      | if ($tags | length) == 0 then ""
        else
          ($tags[0] | tostring) as $first
          | (($tags | length) - 1) as $more
          | if ($first | length) > $width then
              if ($tags | length) == 1 then ellipsis($first; $width) else "\($tags | length) tags" end
            elif $more == 0 then
              ellipsis($first; $width)
            else
              ($first + " + \($more) more") as $full
              | ("\($tags | length) tags") as $countText
              | if ($full | length) <= $width then $full
                elif ($countText | length) <= $width then $countText
                else ellipsis($countText; $width)
                end
            end
        end;

    def terminal_value($row; $col; $map; $counts; $width):
      if $formatter == "tags" and $col == "TAG" then $row | clean | ellipsis(.; $width)
      elif $formatter == "links" and $col == "STARRED" then if $row.starred == true then "*" else "" end
      elif $formatter == "links" and $col == "URL" then $row | getpath($map[$col]) | truncate_url($width)
      elif $formatter == "links" and $col == "TAGS" then $row | format_tags($counts; $width)
      elif ($col | test("AT$")) then $row | getpath($map[$col]) | format_timestamp($width)
      elif $col == "TITLE" or $col == "SUMMARY" or $col == "CONTENT" or $col == "MARKDOWNCONTENT" or $col == "NOTE" then
        $row | getpath($map[$col]) | clean | ellipsis(.; $width)
      else
        $row | getpath($map[$col]) | clean | ellipsis(.; $width)
      end;

    def header_name($col):
      if $formatter == "links" and $col == "STARRED" then "S" else $col end;

    def natural_value($row; $col; $map; $counts):
      terminal_value($row; $col; $map; $counts; 100000);

    def keep_nonempty_columns($rows; $cols; $map; $counts):
      if $columns != "" then
        $cols
      else
        $cols | map(select(
          . as $col
          | any($rows[]; natural_value(.; $col; $map; $counts) != "")
        ))
      end;

    def max_natural_width($rows; $col; $map; $counts):
      ([header_name($col) | length] + ($rows | map(natural_value(.; $col; $map; $counts) | length))) | max;

    def min_width($col):
      (header_name($col) | length) as $headerWidth
      | (if $col == "STARRED" then 1
      elif $col == "URL" then 10
      elif $col == "TAGS" then 6
      elif $col == "TITLE" or $col == "SUMMARY" or $col == "CONTENT" or $col == "MARKDOWNCONTENT" or $col == "NOTE" then 6
      else ([($col | length), 4] | min)
      end) as $valueWidth
      | [$headerWidth, $valueWidth] | max;

    def max_width($col):
      if $formatter == "links" and $col == "URL" then
        ([min_width($col), (($terminalWidth * 18 / 80) | floor)] | max)
      elif ($col | test("AT$")) then
        16
      else
        100000
      end;

    def cap_widths($widths; $cols):
      reduce range(0; $widths | length) as $i ($widths;
        .[$i] = ([.[$i], max_width($cols[$i])] | min)
      );

    def minimum_total_width($cols):
      if ($cols | length) == 0 then
        0
      else
        ($cols | map(min_width(.)) | add) + (($cols | length) - 1) * 3
      end;

    def flexible($col):
      $col == "URL" or $col == "TAGS" or $col == "TITLE" or $col == "SUMMARY" or $col == "CONTENT" or $col == "MARKDOWNCONTENT" or $col == "NOTE" or ($col | test("AT$"));

    def distribute($widths; $cols; $flex; $available):
      (($widths | add) + (($widths | length) - 1) * 3) as $current
      | if $current <= $available or ($flex | length) == 0 then
          $widths
        else
          ($current - $available) as $over
          | ([$flex[] as $i | {i: $i, spare: ([0, ($widths[$i] - min_width($cols[$i]))] | max)}]) as $spares
          | ($spares | map(.spare) | add) as $totalSpare
          | if $totalSpare <= 0 then $widths
            else
              reduce $spares[] as $s ($widths;
                ($over * $s.spare / $totalSpare | ceil) as $cut
                | .[$s.i] = ([min_width($cols[$s.i]), (.[$s.i] - $cut)] | max)
              )
            end
        end;

    def expand_url_when_title_fits($widths; $cols; $naturalRaw; $available):
      ($cols | index("URL")) as $urlIndex
      | ($cols | index("TITLE")) as $titleIndex
      | (($widths | add) + (($cols | length) - 1) * 3) as $current
      | ($available - $current) as $extra
      | if $formatter == "links"
          and $urlIndex != null
          and $extra > 0
          and ($titleIndex == null or $widths[$titleIndex] >= $naturalRaw[$titleIndex])
        then
          .[$urlIndex] = ([($widths[$urlIndex] + $extra), $naturalRaw[$urlIndex]] | min)
        else
          .
        end;

    def fit_widths($rows; $cols; $map; $counts):
      ($cols | map(max_natural_width($rows; .; $map; $counts))) as $naturalRaw
      | cap_widths($naturalRaw; $cols) as $natural
      | ($cols | map(min_width(.))) as $mins
      | (($natural | add) + (($cols | length) - 1) * 3) as $naturalTotal
      | if $naturalTotal <= $terminalWidth then
          $natural
        else
          ($cols | to_entries | map(select(flexible(.value))) | map(.key)) as $flex
          | (reduce range(0; $natural | length) as $i ($natural;
              if ($flex | index($i)) then . else .[$i] = $mins[$i] end
            )) as $initial
          | (($initial | add) + (($cols | length) - 1) * 3) as $initialTotal
          | distribute($initial; $cols; $flex; $terminalWidth)
        end
      | expand_url_when_title_fits(.; $cols; $naturalRaw; $terminalWidth);

    def pad($text; $width):
      ellipsis($text; $width) as $fitted
      | $fitted + (" " * ([0, ($width - ($fitted | length))] | max));

    def center($text; $width):
      ellipsis($text; $width) as $fitted
      | ([0, ($width - ($fitted | length))] | max) as $space
      | (" " * (($space / 2) | floor)) + $fitted + (" " * (($space / 2) | ceil));

    def render($cells; $widths):
      reduce range(0; $cells | length) as $i ("";
        . + (if $i > 0 then " │ " else "" end) + pad($cells[$i]; $widths[$i])
      );

    def render_header($cells; $widths):
      reduce range(0; $cells | length) as $i ("";
        . + (if $i > 0 then " │ " else "" end) + center($cells[$i]; $widths[$i])
      );

    def ruler($widths):
      reduce range(0; $widths | length) as $i ("";
        . + (if $i > 0 then "─┼─" else "" end) + ("─" * $widths[$i])
      );

    data_rows as $rawRows
    | columns as $cols
    | (if $formatter == "links" then link_map
       elif $formatter == "highlights" then highlight_map
       elif $formatter == "lists" then list_map
       elif $formatter == "tags" then {}
       else generic_map
       end) as $map
    | (reduce $cols[] as $col (true; . and validate_col($col; $map)))
    | tag_counts($rawRows) as $counts
    | keep_nonempty_columns($rawRows; $cols; $map; $counts) as $visibleCols
    | if minimum_total_width($visibleCols) > $terminalWidth then
        error("terminal too narrow for requested columns: needs at least \(minimum_total_width($visibleCols)) columns, has \($terminalWidth)")
      else . end
    | fit_widths($rawRows; $visibleCols; $map; $counts) as $widths
    | render_header(($visibleCols | map(header_name(.))); $widths), "\n",
      ruler($widths), "\n",
      ($rawRows[] as $row
       | render(([$visibleCols | to_entries[] as $entry | terminal_value($row; $entry.value; $map; $counts; $widths[$entry.key])]); $widths), "\n")
  '
}

tabular_json() {
  local formatter="$1"
  local separator='"\n"'
  local tab_width=8

  if (( NUL_OUTPUT )); then
    separator='"\u0000"'
  fi

  jq -rj --arg formatter "$formatter" --arg columns "$OUTPUT_COLUMNS" --argjson separator "$separator" --argjson tabWidth "$tab_width" '
    def clean:
      if . == null then ""
      elif type == "array" then map(tostring) | join(",")
      else tostring
      end
      | gsub("[\t\r\n]"; " ");

    def requested_columns($default):
      if $columns == "" then
        $default
      else
        $columns
        | gsub("[[:space:]]+"; "")
        | split(",")
        | map(ascii_upcase)
        | map(select(. != ""))
      end;

    def pick($row; $col; $map):
      if $formatter == "links" and $col == "STARRED" then
        if $row.starred == true then "*" else "" end
      elif $map | has($col) then
        $row | getpath($map[$col]) | clean
      else
        error("unknown output column for " + $formatter + ": " + $col)
      end;

    def keep_nonempty_columns($rows; $cols; $map):
      if $columns != "" then
        $cols
      else
        $cols | map(select(
          . as $col
          | any($rows[]; pick(.; $col; $map) != "")
        ))
      end;

    def rows:
      if $formatter == "links" then
        requested_columns(["STARRED", "TITLE", "URL", "TAGS", "READAT"]) as $cols
        | {
            ID: ["id"],
            URL: ["url"],
            TITLE: ["title"],
            SUMMARY: ["summary"],
            AUTHOR: ["author"],
            TAGS: ["tags"],
            WORDCOUNT: ["wordCount"],
            STARRED: ["starred"],
            HIGHLIGHTED: ["highlighted"],
            ADDEDAT: ["addedAt"],
            MODIFIEDAT: ["modifiedAt"],
            READAT: ["readAt"]
          } as $map
        | (if has("data") then .data else [.] end) as $data
        | keep_nonempty_columns($data; $cols; $map) as $visibleCols
        | [$visibleCols]
        + ($data | map(. as $row | [$visibleCols[] as $col | pick($row; $col; $map)]))
      elif $formatter == "highlights" then
        requested_columns(["CONTENT", "CREATEDAT"]) as $cols
        | {
            ID: ["id"],
            LINKID: ["linkID"],
            CONTENT: ["content"],
            MARKDOWNCONTENT: ["markdownContent"],
            NOTE: ["note"],
            CREATEDAT: ["createdAt"]
          } as $map
        | (if has("data") then .data else [.] end) as $data
        | keep_nonempty_columns($data; $cols; $map) as $visibleCols
        | [$visibleCols]
        + ($data | map(. as $row | [$visibleCols[] as $col | pick($row; $col; $map)]))
      elif $formatter == "lists" then
        requested_columns(["ID"]) as $cols
        | {ID: ["id"], NAME: ["name"]} as $map
        | . as $data
        | keep_nonempty_columns($data; $cols; $map) as $visibleCols
        | [$visibleCols] + ($data | map(. as $row | [$visibleCols[] as $col | pick($row; $col; $map)]))
      elif $formatter == "tags" then
        requested_columns(["TAG"]) as $cols
        | . as $data
        | (if $columns != "" then $cols else $cols | map(select(any($data[]; clean != ""))) end) as $visibleCols
        | [$visibleCols] + ($data | map(. as $row | [$visibleCols[] as $col | if $col == "TAG" then ($row | clean) else error("unknown output column for tags: " + $col) end]))
      else
        requested_columns(["ID", "URL", "TITLE", "NAME", "LINKID", "CONTENT", "NOTE"]) as $cols
        | {
            ID: ["id"],
            URL: ["url"],
            TITLE: ["title"],
            NAME: ["name"],
            LINKID: ["linkID"],
            CONTENT: ["content"],
            NOTE: ["note"]
          } as $map
        | (if type == "array" then .
            elif type == "object" and has("data") then .data
            else [.]
            end) as $data
        | keep_nonempty_columns($data; $cols; $map) as $visibleCols
        | [$visibleCols]
        + ($data | map(
              if type == "object" then
                . as $row | [$visibleCols[] as $col | pick($row; $col; $map)]
              else
                [.] | map(clean)
              end
            ))
      end;

    def column_widths($rows):
      reduce $rows[] as $row ([];
        reduce range(0; $row | length) as $i (.;
          .[$i] = ([.[$i] // 0, ($row[$i] | length)] | max)
        )
      );

    def tab_targets($widths):
      reduce range(0; (($widths | length) - 1)) as $i ({starts: [0], targets: []};
        . as $state
        | $state.starts[$i] as $start
        | (((($start + $widths[$i]) / $tabWidth) | floor) + 1) as $targetTabs
        | ($targetTabs * $tabWidth) as $target
        | $state
        | .targets[$i] = $target
        | .starts[$i + 1] = $target
      )
      | .targets;

    def tab_pad($position; $target):
      ((($target / $tabWidth) | floor) - (($position / $tabWidth) | floor)) as $tabs
      | "\t" * $tabs;

    def render_row($targets):
      . as $row
      | reduce range(0; $row | length) as $i ({text: "", position: 0};
          .text += $row[$i]
          | .position += ($row[$i] | length)
          | if $i < (($row | length) - 1) then
              tab_pad(.position; $targets[$i]) as $tabs
              | .text += $tabs
              | .position = $targets[$i]
            else
              .
            end
        )
      | .text;

    rows as $rows
    | if ($rows | length) == 0 then empty
      else
        column_widths($rows) as $widths
        | tab_targets($widths) as $targets
        | $rows[]
        | render_row($targets), $separator
      end
  '
}

request() {
  local method="$1"
  local endpoint_path="$2"
  local body="${3:-}"
  local formatter="${4:-generic}"
  shift 4 || true
  local query=("$@")

  read_token
  [[ -n "$TOKEN" ]] || die "API token required. Set GOODLINKS_TOKEN or run: goodlinks config set-token <token>"

  local url
  url="$(make_url "$endpoint_path" "${query[@]}")"

  local response headers body_file http_status content_type
  headers="${TMPDIR:-/tmp}/goodlinks-headers-$$-$RANDOM"
  body_file="${TMPDIR:-/tmp}/goodlinks-body-$$-$RANDOM"
  : > "$headers"
  : > "$body_file"

  local -a curl_args=(
    --silent --show-error
    --request "$method"
    --dump-header "$headers"
    --output "$body_file"
    --header "Authorization: Bearer $TOKEN"
  )

  if [[ -n "$body" ]]; then
    curl_args+=(--header "Content-Type: application/json" --data "$body")
  fi

  if ! curl "${curl_args[@]}" "$url"; then
    rm -f "$headers" "$body_file"
    exit 1
  fi

  http_status="$(awk 'tolower($0) ~ /^http\// { code=$2 } END { print code }' "$headers")"
  content_type="$(awk 'tolower($0) ~ /^content-type:/ { sub(/\r$/, ""); print substr($0, index($0,$2)); exit }' "$headers")"

  if [[ "$http_status" -lt 200 || "$http_status" -ge 300 ]]; then
    print -u2 "goodlinks: HTTP $http_status"
    if [[ -s "$body_file" ]]; then
      if [[ "$content_type" == application/json* ]]; then
        jq . "$body_file" >&2 || cat "$body_file" >&2
      else
        cat "$body_file" >&2
      fi
      print -u2
    fi
    rm -f "$headers" "$body_file"
    exit 1
  fi

  if [[ "$http_status" != "204" && -s "$body_file" ]]; then
    format_json_response "$content_type" "$formatter" < "$body_file"
  fi

  rm -f "$headers" "$body_file"
}

bool_value() {
  case "$1" in
    true|false) print -r -- "$1" ;;
    *) die "expected boolean true or false, got: $1" ;;
  esac
}

parse_link_filters() {
  local query_name="$1"
  shift

  while (( $# > 0 )); do
    case "$1" in
      --search) append_query "$query_name" search "${2:?missing value for --search}"; shift 2 ;;
      --tag) append_query "$query_name" tag "${2:?missing value for --tag}"; shift 2 ;;
      --starred) append_query "$query_name" starred "$(bool_value "${2:?missing value for --starred}")"; shift 2 ;;
      --read) append_query "$query_name" read "$(bool_value "${2:?missing value for --read}")"; shift 2 ;;
      --tagged) append_query "$query_name" tagged "$(bool_value "${2:?missing value for --tagged}")"; shift 2 ;;
      --highlighted) append_query "$query_name" highlighted "$(bool_value "${2:?missing value for --highlighted}")"; shift 2 ;;
      --word-count-min) append_query "$query_name" wordCountMin "${2:?missing value for --word-count-min}"; shift 2 ;;
      --word-count-max) append_query "$query_name" wordCountMax "${2:?missing value for --word-count-max}"; shift 2 ;;
      --added-after) append_query "$query_name" addedAfter "${2:?missing value for --added-after}"; shift 2 ;;
      --added-before) append_query "$query_name" addedBefore "${2:?missing value for --added-before}"; shift 2 ;;
      --read-after) append_query "$query_name" readAfter "${2:?missing value for --read-after}"; shift 2 ;;
      --read-before) append_query "$query_name" readBefore "${2:?missing value for --read-before}"; shift 2 ;;
      --sort) append_query "$query_name" sort "${2:?missing value for --sort}"; shift 2 ;;
      --limit) append_query "$query_name" limit "${2:?missing value for --limit}"; shift 2 ;;
      --offset) append_query "$query_name" offset "${2:?missing value for --offset}"; shift 2 ;;
      *) die "unknown links list option: $1" ;;
    esac
  done
}

links_cmd() {
  local sub="${1:-}"
  [[ -n "$sub" ]] || die "missing links subcommand"
  shift || true

  case "$sub" in
    list)
      local query=()
      parse_link_filters query "$@"
      request GET /links "" links "${query[@]}"
      ;;
    get)
      local id=""
      while (( $# > 0 )); do
        case "$1" in
          --id) id="${2:?missing value for --id}"; shift 2 ;;
          *) die "unknown links get option: $1" ;;
        esac
      done
      [[ -n "$id" ]] || die "links get requires --id"
      request GET "/links/$(urlencode "$id")" "" links
      ;;
    get-url)
      local url="" query=()
      while (( $# > 0 )); do
        case "$1" in
          --url) url="${2:?missing value for --url}"; shift 2 ;;
          *) die "unknown links get-url option: $1" ;;
        esac
      done
      [[ -n "$url" ]] || die "links get-url requires --url"
      append_query query url "$url"
      request GET /links "" links "${query[@]}"
      ;;
    current)
      request GET /links/current "" links
      ;;
    add)
      local url="" title="" summary="" read="" starred="" added_at=""
      local tags=()
      while (( $# > 0 )); do
        case "$1" in
          --url) url="${2:?missing value for --url}"; shift 2 ;;
          --title) title="${2:?missing value for --title}"; shift 2 ;;
          --summary) summary="${2:?missing value for --summary}"; shift 2 ;;
          --tag) tags+=("${2:?missing value for --tag}"); shift 2 ;;
          --read) read="$(bool_value "${2:?missing value for --read}")"; shift 2 ;;
          --starred) starred="$(bool_value "${2:?missing value for --starred}")"; shift 2 ;;
          --added-at) added_at="${2:?missing value for --added-at}"; shift 2 ;;
          *) die "unknown links add option: $1" ;;
        esac
      done
      [[ -n "$url" ]] || die "links add requires --url"
      local body
      body="$(jq -cn \
        --arg url "$url" \
        --arg title "$title" \
        --arg summary "$summary" \
        --arg read "$read" \
        --arg starred "$starred" \
        --arg addedAt "$added_at" \
        --argjson tags "$(json_string_array "${tags[@]}")" \
        '{url:$url}
        | if $title != "" then .title=$title else . end
        | if $summary != "" then .summary=$summary else . end
        | if ($tags|length) > 0 then .tags=$tags else . end
        | if $read != "" then .read=($read == "true") else . end
        | if $starred != "" then .starred=($starred == "true") else . end
        | if $addedAt != "" then .addedAt=$addedAt else . end')"
      request POST /links "$body" links
      ;;
    update)
      local id="" title="" summary="" read="" starred="" clear_tags=0
      local tags=() added_tags=() removed_tags=()
      while (( $# > 0 )); do
        case "$1" in
          --id) id="${2:?missing value for --id}"; shift 2 ;;
          --title) title="${2:?missing value for --title}"; shift 2 ;;
          --summary) summary="${2:?missing value for --summary}"; shift 2 ;;
          --starred) starred="$(bool_value "${2:?missing value for --starred}")"; shift 2 ;;
          --read) read="$(bool_value "${2:?missing value for --read}")"; shift 2 ;;
          --add-tag) added_tags+=("${2:?missing value for --add-tag}"); shift 2 ;;
          --remove-tag) removed_tags+=("${2:?missing value for --remove-tag}"); shift 2 ;;
          --tag) tags+=("${2:?missing value for --tag}"); shift 2 ;;
          --clear-tags) clear_tags=1; shift ;;
          *) die "unknown links update option: $1" ;;
        esac
      done
      [[ -n "$id" ]] || die "links update requires --id"
      local body
      body="$(jq -cn \
        --arg title "$title" \
        --arg summary "$summary" \
        --arg read "$read" \
        --arg starred "$starred" \
        --argjson clearTags "$clear_tags" \
        --argjson tags "$(json_string_array "${tags[@]}")" \
        --argjson addedTags "$(json_string_array "${added_tags[@]}")" \
        --argjson removedTags "$(json_string_array "${removed_tags[@]}")" \
        '{} 
        | if $title != "" then .title=$title else . end
        | if $summary != "" then .summary=$summary else . end
        | if $starred != "" then .starred=($starred == "true") else . end
        | if $read != "" then .read=($read == "true") else . end
        | if $clearTags == 1 then .tags=[] elif ($tags|length) > 0 then .tags=$tags else . end
        | if ($addedTags|length) > 0 then .addedTags=$addedTags else . end
        | if ($removedTags|length) > 0 then .removedTags=$removedTags else . end')"
      request PATCH "/links/$(urlencode "$id")" "$body" links
      ;;
    delete)
      local ids=() query=()
      while (( $# > 0 )); do
        case "$1" in
          --id) ids+=("${2:?missing value for --id}"); shift 2 ;;
          *) die "unknown links delete option: $1" ;;
        esac
      done
      (( ${#ids[@]} > 0 )) || die "links delete requires at least one --id"
      for id in "${ids[@]}"; do
        append_query query id "$id"
      done
      request DELETE /links "" generic "${query[@]}"
      ;;
    content)
      local id="" format="" auto_download="" query=()
      while (( $# > 0 )); do
        case "$1" in
          --id) id="${2:?missing value for --id}"; shift 2 ;;
          --format) format="${2:?missing value for --format}"; shift 2 ;;
          --auto-download) auto_download="$(bool_value "${2:?missing value for --auto-download}")"; shift 2 ;;
          *) die "unknown links content option: $1" ;;
        esac
      done
      [[ -n "$id" ]] || die "links content requires --id"
      append_query query format "$format"
      append_query query autoDownload "$auto_download"
      request GET "/links/$(urlencode "$id")/content" "" raw "${query[@]}"
      ;;
    *) die "unknown links subcommand: $sub" ;;
  esac
}

lists_cmd() {
  local sub="${1:-}"
  [[ -n "$sub" ]] || die "missing lists subcommand"
  shift || true

  case "$sub" in
    list)
      request GET /lists "" lists
      ;;
    get)
      local list="" search="" include_read="" limit="" offset=""
      local tags=() query=()
      while (( $# > 0 )); do
        case "$1" in
          --list) list="${2:?missing value for --list}"; shift 2 ;;
          --search) search="${2:?missing value for --search}"; shift 2 ;;
          --tag) tags+=("${2:?missing value for --tag}"); shift 2 ;;
          --include-read) include_read="$(bool_value "${2:?missing value for --include-read}")"; shift 2 ;;
          --limit) limit="${2:?missing value for --limit}"; shift 2 ;;
          --offset) offset="${2:?missing value for --offset}"; shift 2 ;;
          *) die "unknown lists get option: $1" ;;
        esac
      done
      [[ -n "$list" ]] || die "lists get requires --list"
      append_query query search "$search"
      for tag in "${tags[@]}"; do
        append_query query tag "$tag"
      done
      append_query query includeRead "$include_read"
      append_query query limit "$limit"
      append_query query offset "$offset"
      request GET "/lists/$(urlencode "$list")" "" links "${query[@]}"
      ;;
    *) die "unknown lists subcommand: $sub" ;;
  esac
}

tags_cmd() {
  local sub="${1:-}"
  case "$sub" in
    list) request GET /tags "" tags ;;
    *) die "unknown tags subcommand: ${sub:-}" ;;
  esac
}

highlights_cmd() {
  local sub="${1:-}"
  [[ -n "$sub" ]] || die "missing highlights subcommand"
  shift || true

  case "$sub" in
    list)
      local query=()
      while (( $# > 0 )); do
        case "$1" in
          --q) append_query query q "${2:?missing value for --q}"; shift 2 ;;
          --link-id) append_query query linkID "${2:?missing value for --link-id}"; shift 2 ;;
          --content) append_query query content "${2:?missing value for --content}"; shift 2 ;;
          --note) append_query query note "${2:?missing value for --note}"; shift 2 ;;
          --created-after) append_query query createdAfter "${2:?missing value for --created-after}"; shift 2 ;;
          --created-before) append_query query createdBefore "${2:?missing value for --created-before}"; shift 2 ;;
          --sort) append_query query sort "${2:?missing value for --sort}"; shift 2 ;;
          --limit) append_query query limit "${2:?missing value for --limit}"; shift 2 ;;
          --offset) append_query query offset "${2:?missing value for --offset}"; shift 2 ;;
          *) die "unknown highlights list option: $1" ;;
        esac
      done
      request GET /highlights "" highlights "${query[@]}"
      ;;
    update)
      local id="" note="" note_set=0
      while (( $# > 0 )); do
        case "$1" in
          --id) id="${2:?missing value for --id}"; shift 2 ;;
          --note) note="${2-}"; note_set=1; shift 2 ;;
          *) die "unknown highlights update option: $1" ;;
        esac
      done
      [[ -n "$id" ]] || die "highlights update requires --id"
      (( note_set )) || die "highlights update requires --note"
      local body
      body="$(jq -cn --arg note "$note" '{note:$note}')"
      request PATCH "/highlights/$(urlencode "$id")" "$body" highlights
      ;;
    export)
      local link_id=""
      while (( $# > 0 )); do
        case "$1" in
          --link-id) link_id="${2:?missing value for --link-id}"; shift 2 ;;
          *) die "unknown highlights export option: $1" ;;
        esac
      done
      [[ -n "$link_id" ]] || die "highlights export requires --link-id"
      request GET "/links/$(urlencode "$link_id")/highlights/export" "" raw
      ;;
    *) die "unknown highlights subcommand: $sub" ;;
  esac
}

config_cmd() {
  local sub="${1:-}"
  shift || true

  case "$sub" in
    set-token)
      local token="${1:-}"
      [[ -n "$token" ]] || die "config set-token requires a token"
      mkdir -p "$CONFIG_DIR"
      umask 077
      print -r -- "$token" > "$TOKEN_FILE"
      print "Token saved to $TOKEN_FILE"
      ;;
    show)
      read_token
      print "baseUrl: $BASE_URL"
      if [[ -n "$TOKEN" ]]; then
        print "token: configured"
      else
        print "token: missing"
      fi
      ;;
    *) die "unknown config subcommand: ${sub:-}" ;;
  esac
}

main() {
  need curl
  need jq

  while (( $# > 0 )); do
    case "$1" in
      --token) TOKEN="${2:?missing value for --token}"; shift 2 ;;
      --base-url) BASE_URL="${2:?missing value for --base-url}"; shift 2 ;;
      --json) JSON_OUTPUT=1; shift ;;
      --raw) RAW_OUTPUT=1; shift ;;
      -O) OUTPUT_COLUMNS="${2:?missing value for -O}"; shift 2 ;;
      -0) NUL_OUTPUT=1; shift ;;
      -h|--help) usage; exit 0 ;;
      --) shift; break ;;
      -*) die "unknown global option: $1" ;;
      *) break ;;
    esac
  done

  local command="${1:-}"
  [[ -n "$command" ]] || { usage; exit 0; }
  shift || true

  case "$command" in
    config) config_cmd "$@" ;;
    links) links_cmd "$@" ;;
    lists) lists_cmd "$@" ;;
    tags) tags_cmd "$@" ;;
    highlights) highlights_cmd "$@" ;;
    help) usage ;;
    *) die "unknown command: $command" ;;
  esac
}

main "$@"
