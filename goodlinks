#!/usr/bin/env zsh

set -euo pipefail

BASE_URL_DEFAULT="http://localhost:9428/api/v1"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/goodlinks-cli"
TOKEN_FILE="$CONFIG_DIR/token"

BASE_URL="${GOODLINKS_BASE_URL:-$BASE_URL_DEFAULT}"
TOKEN="${GOODLINKS_TOKEN:-}"
RAW_OUTPUT=0
JSON_OUTPUT=0
NUL_OUTPUT=0

die() {
  print -u2 "goodlinks: $*"
  exit 1
}

need() {
  command -v "$1" >/dev/null 2>&1 || die "missing required command: $1"
}

usage() {
  cat <<'EOF'
GoodLinks CLI

Usage:
  goodlinks [global options] <command> [options]

Global options:
  --token <token>       API token. Defaults to GOODLINKS_TOKEN or config token.
  --base-url <url>      API base URL. Defaults to GOODLINKS_BASE_URL or http://localhost:9428/api/v1.
  --json               Pretty-print JSON responses.
  --raw                Print response body exactly as returned.
  -0                   Separate tabular records with NUL instead of newline.
  -h, --help           Show help.

Default tabular fields:
  links:       id url title starred readAt tags
  lists:       id name
  tags:        tag
  highlights:  id linkID content note createdAt

Token commands:
  config set-token <token>
  config show

Link commands:
  links list [filters]
  links get --id <id>
  links get-url --url <url>
  links current
  links add --url <url> [--title <text>] [--summary <text>] [--tag <tag> ...] [--read <bool>] [--starred <bool>] [--added-at <timestamp>]
  links update --id <id> [--title <text>] [--summary <text>] [--starred <bool>] [--read <bool>] [--add-tag <tag> ...] [--remove-tag <tag> ...] [--tag <tag> ...] [--clear-tags]
  links delete --id <id> [--id <id> ...]
  links content --id <id> [--format html|plaintext|markdown] [--auto-download <bool>]

List commands:
  lists list
  lists get --list all|unread|read|starred|untagged|highlighted [--search <text>] [--tag <tag> ...] [--include-read <bool>] [--limit <n>] [--offset <n>]

Tag commands:
  tags list

Highlight commands:
  highlights list [filters]
  highlights update --id <id> [--note <text>]
  highlights export --link-id <id>

Common link filters:
  --search <text> --tag <tag> --starred <bool> --read <bool> --tagged <bool>
  --highlighted <bool> --word-count-min <n> --word-count-max <n>
  --added-after <timestamp> --added-before <timestamp>
  --read-after <timestamp> --read-before <timestamp>
  --sort <value> --limit <n> --offset <n>

Highlight filters:
  --q <text> --link-id <id> --content <text> --note <text>
  --created-after <timestamp> --created-before <timestamp>
  --sort <value> --limit <n> --offset <n>

Examples:
  goodlinks links list --read false --search python --limit 20
  goodlinks -0 links list --read false | cut -z -f1 | xargs -0 -n1 echo
  goodlinks --json links get --id abc123
  goodlinks links add --url https://example.com --tag reading --starred true
  goodlinks --raw links content --id abc123 --format markdown
  goodlinks highlights update --id highlight123 --note "Key insight"
EOF
}

read_token() {
  if [[ -n "$TOKEN" ]]; then
    return
  fi

  if [[ -f "$TOKEN_FILE" ]]; then
    TOKEN="$(<"$TOKEN_FILE")"
    TOKEN="${TOKEN//$'\n'/}"
  fi
}

urlencode() {
  jq -nr --arg v "$1" '$v|@uri'
}

json_string_array() {
  jq -cn '$ARGS.positional' --args "$@"
}

append_query() {
  local query_name="$1"
  local key="$2"
  local value="$3"

  [[ -n "$value" ]] || return
  local encoded
  encoded="$(urlencode "$key")=$(urlencode "$value")"
  eval "$query_name+=(\"\$encoded\")"
}

make_url() {
  local endpoint_path="$1"
  shift
  local query=("$@")
  local url="${BASE_URL}${endpoint_path}"

  if (( ${#query[@]} > 0 )); then
    local IFS='&'
    url="${url}?${query[*]}"
  fi

  print -r -- "$url"
}

format_json_response() {
  local content_type="$1"
  local formatter="$2"

  if (( RAW_OUTPUT )); then
    cat
    return
  fi

  if [[ "$content_type" == application/json* ]]; then
    if (( JSON_OUTPUT )); then
      jq .
    else
      tabular_json "$formatter"
    fi
  else
    cat
  fi
}

tabular_json() {
  local formatter="$1"
  local separator='"\n"'
  local tab_width=8

  if (( NUL_OUTPUT )); then
    separator='"\u0000"'
  fi

  jq -rj --arg formatter "$formatter" --argjson separator "$separator" --argjson tabWidth "$tab_width" '
    def clean:
      if . == null then ""
      elif type == "array" then map(tostring) | join(",")
      else tostring
      end
      | gsub("[\t\r\n]"; " ");

    def rows:
      if $formatter == "links" then
        [["ID", "URL", "TITLE", "STARRED", "READAT", "TAGS"]]
        + ((if has("data") then .data else [.] end)
          | map([.id, .url, .title, .starred, .readAt, .tags] | map(clean)))
      elif $formatter == "highlights" then
        [["ID", "LINKID", "CONTENT", "NOTE", "CREATEDAT"]]
        + ((if has("data") then .data else [.] end)
          | map([.id, .linkID, .content, .note, .createdAt] | map(clean)))
      elif $formatter == "lists" then
        [["ID", "NAME"]] + (map([.id, .name] | map(clean)))
      elif $formatter == "tags" then
        [["TAG"]] + (map([.] | map(clean)))
      else
        [["ID", "URL", "TITLE", "NAME", "LINKID", "CONTENT", "NOTE"]]
        + ((if type == "array" then .
            elif type == "object" and has("data") then .data
            else [.]
            end)
          | map(
              if type == "object" then
                [.id, .url, .title, .name, .linkID, .content, .note] | map(clean)
              else
                [.] | map(clean)
              end
            ))
      end;

    def column_widths($rows):
      reduce $rows[] as $row ([];
        reduce range(0; $row | length) as $i (.;
          .[$i] = ([.[$i] // 0, ($row[$i] | length)] | max)
        )
      );

    def tab_targets($widths):
      reduce range(0; (($widths | length) - 1)) as $i ({starts: [0], targets: []};
        . as $state
        | $state.starts[$i] as $start
        | (((($start + $widths[$i]) / $tabWidth) | floor) + 1) as $targetTabs
        | ($targetTabs * $tabWidth) as $target
        | $state
        | .targets[$i] = $target
        | .starts[$i + 1] = $target
      )
      | .targets;

    def tab_pad($position; $target):
      ((($target / $tabWidth) | floor) - (($position / $tabWidth) | floor)) as $tabs
      | "\t" * $tabs;

    def render_row($targets):
      . as $row
      | reduce range(0; $row | length) as $i ({text: "", position: 0};
          .text += $row[$i]
          | .position += ($row[$i] | length)
          | if $i < (($row | length) - 1) then
              tab_pad(.position; $targets[$i]) as $tabs
              | .text += $tabs
              | .position = $targets[$i]
            else
              .
            end
        )
      | .text;

    rows as $rows
    | if ($rows | length) == 0 then empty
      else
        column_widths($rows) as $widths
        | tab_targets($widths) as $targets
        | $rows[]
        | render_row($targets), $separator
      end
  '
}

request() {
  local method="$1"
  local endpoint_path="$2"
  local body="${3:-}"
  local formatter="${4:-generic}"
  shift 4 || true
  local query=("$@")

  read_token
  [[ -n "$TOKEN" ]] || die "API token required. Set GOODLINKS_TOKEN or run: goodlinks config set-token <token>"

  local url
  url="$(make_url "$endpoint_path" "${query[@]}")"

  local response headers body_file http_status content_type
  headers="${TMPDIR:-/tmp}/goodlinks-headers-$$-$RANDOM"
  body_file="${TMPDIR:-/tmp}/goodlinks-body-$$-$RANDOM"
  : > "$headers"
  : > "$body_file"

  local -a curl_args=(
    --silent --show-error
    --request "$method"
    --dump-header "$headers"
    --output "$body_file"
    --header "Authorization: Bearer $TOKEN"
  )

  if [[ -n "$body" ]]; then
    curl_args+=(--header "Content-Type: application/json" --data "$body")
  fi

  if ! curl "${curl_args[@]}" "$url"; then
    rm -f "$headers" "$body_file"
    exit 1
  fi

  http_status="$(awk 'tolower($0) ~ /^http\// { code=$2 } END { print code }' "$headers")"
  content_type="$(awk 'tolower($0) ~ /^content-type:/ { sub(/\r$/, ""); print substr($0, index($0,$2)); exit }' "$headers")"

  if [[ "$http_status" -lt 200 || "$http_status" -ge 300 ]]; then
    print -u2 "goodlinks: HTTP $http_status"
    if [[ -s "$body_file" ]]; then
      if [[ "$content_type" == application/json* ]]; then
        jq . "$body_file" >&2 || cat "$body_file" >&2
      else
        cat "$body_file" >&2
      fi
      print -u2
    fi
    rm -f "$headers" "$body_file"
    exit 1
  fi

  if [[ "$http_status" != "204" && -s "$body_file" ]]; then
    format_json_response "$content_type" "$formatter" < "$body_file"
  fi

  rm -f "$headers" "$body_file"
}

bool_value() {
  case "$1" in
    true|false) print -r -- "$1" ;;
    *) die "expected boolean true or false, got: $1" ;;
  esac
}

parse_link_filters() {
  local query_name="$1"
  shift

  while (( $# > 0 )); do
    case "$1" in
      --search) append_query "$query_name" search "${2:?missing value for --search}"; shift 2 ;;
      --tag) append_query "$query_name" tag "${2:?missing value for --tag}"; shift 2 ;;
      --starred) append_query "$query_name" starred "$(bool_value "${2:?missing value for --starred}")"; shift 2 ;;
      --read) append_query "$query_name" read "$(bool_value "${2:?missing value for --read}")"; shift 2 ;;
      --tagged) append_query "$query_name" tagged "$(bool_value "${2:?missing value for --tagged}")"; shift 2 ;;
      --highlighted) append_query "$query_name" highlighted "$(bool_value "${2:?missing value for --highlighted}")"; shift 2 ;;
      --word-count-min) append_query "$query_name" wordCountMin "${2:?missing value for --word-count-min}"; shift 2 ;;
      --word-count-max) append_query "$query_name" wordCountMax "${2:?missing value for --word-count-max}"; shift 2 ;;
      --added-after) append_query "$query_name" addedAfter "${2:?missing value for --added-after}"; shift 2 ;;
      --added-before) append_query "$query_name" addedBefore "${2:?missing value for --added-before}"; shift 2 ;;
      --read-after) append_query "$query_name" readAfter "${2:?missing value for --read-after}"; shift 2 ;;
      --read-before) append_query "$query_name" readBefore "${2:?missing value for --read-before}"; shift 2 ;;
      --sort) append_query "$query_name" sort "${2:?missing value for --sort}"; shift 2 ;;
      --limit) append_query "$query_name" limit "${2:?missing value for --limit}"; shift 2 ;;
      --offset) append_query "$query_name" offset "${2:?missing value for --offset}"; shift 2 ;;
      *) die "unknown links list option: $1" ;;
    esac
  done
}

links_cmd() {
  local sub="${1:-}"
  [[ -n "$sub" ]] || die "missing links subcommand"
  shift || true

  case "$sub" in
    list)
      local query=()
      parse_link_filters query "$@"
      request GET /links "" links "${query[@]}"
      ;;
    get)
      local id=""
      while (( $# > 0 )); do
        case "$1" in
          --id) id="${2:?missing value for --id}"; shift 2 ;;
          *) die "unknown links get option: $1" ;;
        esac
      done
      [[ -n "$id" ]] || die "links get requires --id"
      request GET "/links/$(urlencode "$id")" "" links
      ;;
    get-url)
      local url="" query=()
      while (( $# > 0 )); do
        case "$1" in
          --url) url="${2:?missing value for --url}"; shift 2 ;;
          *) die "unknown links get-url option: $1" ;;
        esac
      done
      [[ -n "$url" ]] || die "links get-url requires --url"
      append_query query url "$url"
      request GET /links "" links "${query[@]}"
      ;;
    current)
      request GET /links/current "" links
      ;;
    add)
      local url="" title="" summary="" read="" starred="" added_at=""
      local tags=()
      while (( $# > 0 )); do
        case "$1" in
          --url) url="${2:?missing value for --url}"; shift 2 ;;
          --title) title="${2:?missing value for --title}"; shift 2 ;;
          --summary) summary="${2:?missing value for --summary}"; shift 2 ;;
          --tag) tags+=("${2:?missing value for --tag}"); shift 2 ;;
          --read) read="$(bool_value "${2:?missing value for --read}")"; shift 2 ;;
          --starred) starred="$(bool_value "${2:?missing value for --starred}")"; shift 2 ;;
          --added-at) added_at="${2:?missing value for --added-at}"; shift 2 ;;
          *) die "unknown links add option: $1" ;;
        esac
      done
      [[ -n "$url" ]] || die "links add requires --url"
      local body
      body="$(jq -cn \
        --arg url "$url" \
        --arg title "$title" \
        --arg summary "$summary" \
        --arg read "$read" \
        --arg starred "$starred" \
        --arg addedAt "$added_at" \
        --argjson tags "$(json_string_array "${tags[@]}")" \
        '{url:$url}
        | if $title != "" then .title=$title else . end
        | if $summary != "" then .summary=$summary else . end
        | if ($tags|length) > 0 then .tags=$tags else . end
        | if $read != "" then .read=($read == "true") else . end
        | if $starred != "" then .starred=($starred == "true") else . end
        | if $addedAt != "" then .addedAt=$addedAt else . end')"
      request POST /links "$body" links
      ;;
    update)
      local id="" title="" summary="" read="" starred="" clear_tags=0
      local tags=() added_tags=() removed_tags=()
      while (( $# > 0 )); do
        case "$1" in
          --id) id="${2:?missing value for --id}"; shift 2 ;;
          --title) title="${2:?missing value for --title}"; shift 2 ;;
          --summary) summary="${2:?missing value for --summary}"; shift 2 ;;
          --starred) starred="$(bool_value "${2:?missing value for --starred}")"; shift 2 ;;
          --read) read="$(bool_value "${2:?missing value for --read}")"; shift 2 ;;
          --add-tag) added_tags+=("${2:?missing value for --add-tag}"); shift 2 ;;
          --remove-tag) removed_tags+=("${2:?missing value for --remove-tag}"); shift 2 ;;
          --tag) tags+=("${2:?missing value for --tag}"); shift 2 ;;
          --clear-tags) clear_tags=1; shift ;;
          *) die "unknown links update option: $1" ;;
        esac
      done
      [[ -n "$id" ]] || die "links update requires --id"
      local body
      body="$(jq -cn \
        --arg title "$title" \
        --arg summary "$summary" \
        --arg read "$read" \
        --arg starred "$starred" \
        --argjson clearTags "$clear_tags" \
        --argjson tags "$(json_string_array "${tags[@]}")" \
        --argjson addedTags "$(json_string_array "${added_tags[@]}")" \
        --argjson removedTags "$(json_string_array "${removed_tags[@]}")" \
        '{} 
        | if $title != "" then .title=$title else . end
        | if $summary != "" then .summary=$summary else . end
        | if $starred != "" then .starred=($starred == "true") else . end
        | if $read != "" then .read=($read == "true") else . end
        | if $clearTags == 1 then .tags=[] elif ($tags|length) > 0 then .tags=$tags else . end
        | if ($addedTags|length) > 0 then .addedTags=$addedTags else . end
        | if ($removedTags|length) > 0 then .removedTags=$removedTags else . end')"
      request PATCH "/links/$(urlencode "$id")" "$body" links
      ;;
    delete)
      local ids=() query=()
      while (( $# > 0 )); do
        case "$1" in
          --id) ids+=("${2:?missing value for --id}"); shift 2 ;;
          *) die "unknown links delete option: $1" ;;
        esac
      done
      (( ${#ids[@]} > 0 )) || die "links delete requires at least one --id"
      for id in "${ids[@]}"; do
        append_query query id "$id"
      done
      request DELETE /links "" generic "${query[@]}"
      ;;
    content)
      local id="" format="" auto_download="" query=()
      while (( $# > 0 )); do
        case "$1" in
          --id) id="${2:?missing value for --id}"; shift 2 ;;
          --format) format="${2:?missing value for --format}"; shift 2 ;;
          --auto-download) auto_download="$(bool_value "${2:?missing value for --auto-download}")"; shift 2 ;;
          *) die "unknown links content option: $1" ;;
        esac
      done
      [[ -n "$id" ]] || die "links content requires --id"
      append_query query format "$format"
      append_query query autoDownload "$auto_download"
      request GET "/links/$(urlencode "$id")/content" "" raw "${query[@]}"
      ;;
    *) die "unknown links subcommand: $sub" ;;
  esac
}

lists_cmd() {
  local sub="${1:-}"
  [[ -n "$sub" ]] || die "missing lists subcommand"
  shift || true

  case "$sub" in
    list)
      request GET /lists "" lists
      ;;
    get)
      local list="" search="" include_read="" limit="" offset=""
      local tags=() query=()
      while (( $# > 0 )); do
        case "$1" in
          --list) list="${2:?missing value for --list}"; shift 2 ;;
          --search) search="${2:?missing value for --search}"; shift 2 ;;
          --tag) tags+=("${2:?missing value for --tag}"); shift 2 ;;
          --include-read) include_read="$(bool_value "${2:?missing value for --include-read}")"; shift 2 ;;
          --limit) limit="${2:?missing value for --limit}"; shift 2 ;;
          --offset) offset="${2:?missing value for --offset}"; shift 2 ;;
          *) die "unknown lists get option: $1" ;;
        esac
      done
      [[ -n "$list" ]] || die "lists get requires --list"
      append_query query search "$search"
      for tag in "${tags[@]}"; do
        append_query query tag "$tag"
      done
      append_query query includeRead "$include_read"
      append_query query limit "$limit"
      append_query query offset "$offset"
      request GET "/lists/$(urlencode "$list")" "" links "${query[@]}"
      ;;
    *) die "unknown lists subcommand: $sub" ;;
  esac
}

tags_cmd() {
  local sub="${1:-}"
  case "$sub" in
    list) request GET /tags "" tags ;;
    *) die "unknown tags subcommand: ${sub:-}" ;;
  esac
}

highlights_cmd() {
  local sub="${1:-}"
  [[ -n "$sub" ]] || die "missing highlights subcommand"
  shift || true

  case "$sub" in
    list)
      local query=()
      while (( $# > 0 )); do
        case "$1" in
          --q) append_query query q "${2:?missing value for --q}"; shift 2 ;;
          --link-id) append_query query linkID "${2:?missing value for --link-id}"; shift 2 ;;
          --content) append_query query content "${2:?missing value for --content}"; shift 2 ;;
          --note) append_query query note "${2:?missing value for --note}"; shift 2 ;;
          --created-after) append_query query createdAfter "${2:?missing value for --created-after}"; shift 2 ;;
          --created-before) append_query query createdBefore "${2:?missing value for --created-before}"; shift 2 ;;
          --sort) append_query query sort "${2:?missing value for --sort}"; shift 2 ;;
          --limit) append_query query limit "${2:?missing value for --limit}"; shift 2 ;;
          --offset) append_query query offset "${2:?missing value for --offset}"; shift 2 ;;
          *) die "unknown highlights list option: $1" ;;
        esac
      done
      request GET /highlights "" highlights "${query[@]}"
      ;;
    update)
      local id="" note="" note_set=0
      while (( $# > 0 )); do
        case "$1" in
          --id) id="${2:?missing value for --id}"; shift 2 ;;
          --note) note="${2-}"; note_set=1; shift 2 ;;
          *) die "unknown highlights update option: $1" ;;
        esac
      done
      [[ -n "$id" ]] || die "highlights update requires --id"
      (( note_set )) || die "highlights update requires --note"
      local body
      body="$(jq -cn --arg note "$note" '{note:$note}')"
      request PATCH "/highlights/$(urlencode "$id")" "$body" highlights
      ;;
    export)
      local link_id=""
      while (( $# > 0 )); do
        case "$1" in
          --link-id) link_id="${2:?missing value for --link-id}"; shift 2 ;;
          *) die "unknown highlights export option: $1" ;;
        esac
      done
      [[ -n "$link_id" ]] || die "highlights export requires --link-id"
      request GET "/links/$(urlencode "$link_id")/highlights/export" "" raw
      ;;
    *) die "unknown highlights subcommand: $sub" ;;
  esac
}

config_cmd() {
  local sub="${1:-}"
  shift || true

  case "$sub" in
    set-token)
      local token="${1:-}"
      [[ -n "$token" ]] || die "config set-token requires a token"
      mkdir -p "$CONFIG_DIR"
      umask 077
      print -r -- "$token" > "$TOKEN_FILE"
      print "Token saved to $TOKEN_FILE"
      ;;
    show)
      read_token
      print "baseUrl: $BASE_URL"
      if [[ -n "$TOKEN" ]]; then
        print "token: configured"
      else
        print "token: missing"
      fi
      ;;
    *) die "unknown config subcommand: ${sub:-}" ;;
  esac
}

main() {
  need curl
  need jq

  while (( $# > 0 )); do
    case "$1" in
      --token) TOKEN="${2:?missing value for --token}"; shift 2 ;;
      --base-url) BASE_URL="${2:?missing value for --base-url}"; shift 2 ;;
      --json) JSON_OUTPUT=1; shift ;;
      --raw) RAW_OUTPUT=1; shift ;;
      -0) NUL_OUTPUT=1; shift ;;
      -h|--help) usage; exit 0 ;;
      --) shift; break ;;
      -*) die "unknown global option: $1" ;;
      *) break ;;
    esac
  done

  local command="${1:-}"
  [[ -n "$command" ]] || { usage; exit 0; }
  shift || true

  case "$command" in
    config) config_cmd "$@" ;;
    links) links_cmd "$@" ;;
    lists) lists_cmd "$@" ;;
    tags) tags_cmd "$@" ;;
    highlights) highlights_cmd "$@" ;;
    help) usage ;;
    *) die "unknown command: $command" ;;
  esac
}

main "$@"
